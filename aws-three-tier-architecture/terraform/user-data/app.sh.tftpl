#!/bin/bash
set -euo pipefail

dnf install -y nodejs npm

mkdir -p /opt/three-tier-api

cat > /opt/three-tier-api/package.json <<'JSON'
${package_json}
JSON

cat > /opt/three-tier-api/db.js <<'JS'
${db_js}
JS

cat > /opt/three-tier-api/server.js <<'JS'
${server_js}
JS

cat > /opt/three-tier-api/schema.sql <<'SQL'
${schema_sql}
SQL

cd /opt/three-tier-api

npm install --omit=dev

cat > /etc/systemd/system/three-tier-api.service <<'SERVICE'
[Unit]
Description=Three-Tier Node.js API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/three-tier-api
EnvironmentFile=-/etc/three-tier-api.env
ExecStart=/usr/bin/node /opt/three-tier-api/server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
SERVICE

systemctl daemon-reload
systemctl enable three-tier-api
systemctl restart three-tier-api
